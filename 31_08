#include <stdio.h>
#include <stdlib.h>


int main() {

	int n;

 
	printf("informe o numero: ");
	scanf("%d", &n);
	
	// equivalente (n>= 1 && n<=10)
	if ( n<10 && n>0 )
		// isso é (!n==4 || n==6 || n==8 || n==9)
		if( n==1 || n==2 || n==3 || n==5 || n==7)
			printf("%d é um numero primo e o dobre = |%d|", n, (n*2));
		else if (n%2 == 0)
			printf("n+2 = %d ", n, (n+2));
			
		else
			printf(" |%d|%d|%d|", n-1, n, n+1);
			
		else printf("_out_of_range");
	
	

	char op;
	scanf("%c", &op);
	switch(op){
	case 'a' : printf("Opa ta falando com ele"); break;
	
	case 'b' : printf("Benedito"); break;
	
	case 'c' : printf("É complicado a situação"); break;
	
	case 'd' : printf("Tamo junto"); break;
	}	
	
	return 0;
}
